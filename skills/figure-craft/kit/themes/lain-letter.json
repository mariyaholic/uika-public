  "fonts": {
    "display": {
      "family": "'TrixieCyr Plain', serif",
      "system": true,
      "src": "<USER_FONTS_DIR>/TrixieCyr-Plain.ttf"
    },
    "brand": {
      "family": "'Love Letter Typewriter', monospace",
      "system": true,
      "src": "<USER_FONTS_DIR>/LoveLetterTypewriter.ttf"
    },
    "mono": {
      "family": "'Love Letter Typewriter', monospace",
      "system": true,
