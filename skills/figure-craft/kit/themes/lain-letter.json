    },
    "gold-bright": {
      "$value": "#ffffff"
    },
    "gold-dim": {
      "$value": "#7d837c"
    },
    "lavender": {
      "$value": "#8fa0c0"
    },
    "marigold": {
      "$value": "#c9a227"
    },
    "lining": {
      "$value": "#b3342f"
    },
    "sage": {
      "$value": "#6e9c7e"
    },
    "wine": {
      "$value": "#7a2340"
