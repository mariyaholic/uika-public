    "muted": {
      "$value": "#7c9182"
    },
    "slate": {
      "$value": "#5b6d61"
    }
  },
  "fontFamily": {
    "$type": "fontFamily",
    "font-display": {
      "$value": "Consolas, monospace"
    },
    "font-brand": {
      "$value": "Consolas, monospace"
    },
    "font-mono": {
      "$value": "Consolas, monospace"
    }
  },
  "fonts": {
    "display": {
      "family": "Consolas, monospace",
      "system": true
    },
    "brand": {
      "family": "Consolas, monospace",
      "system": true
    },
    "mono": {
      "family": "Consolas, monospace",
      "system": true
    }
  }
}
